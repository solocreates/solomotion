{
  "name": "@solomotion/mcp",
  "version": "1.0.0-beta.1",
  "type": "module",
  "description": "Drive a running SoloMotion editor from Claude Code, Claude Desktop, Cursor or any MCP client — every editor verb as a tool, renders as images, the skill as resources.",
  "bin": {
    "solomotion-mcp": "./src/cli.mjs"
  },
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./identity": {
      "types": "./src/identity.d.mts",
      "default": "./src/identity.mjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=45000 test/*.test.mjs",
    "prepack": "node scripts/pack-skill.mjs"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "license": "GPL-3.0-only",
  "keywords": [
    "solomotion",
    "mcp",
    "model-context-protocol",
    "claude-code",
    "motion-design",
    "video-editing"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novincode/solomotion.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/novincode/solomotion/tree/main/packages/mcp#readme",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "src/cli.mjs",
    "src/identity.mjs",
    "src/identity.d.mts",
    "src/identity.json",
    "src/protocol.ts",
    "skill",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "bugs": {
    "url": "https://github.com/novincode/solomotion/issues"
  }
}
