{
  "name": "@solomotion/mcp",
  "version": "1.0.0-beta.1",
  "description": "The SoloMotion MCP server: lets Claude Code, Cursor or any MCP client drive a running SoloMotion editor.",
  "keywords": [
    "solomotion",
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "claude-code",
    "motion-graphics",
    "animation",
    "video-editor"
  ],
  "license": "GPL-3.0-only",
  "type": "module",
  "bin": {
    "solomotion-mcp": "src/cli.mjs"
  },
  "exports": {
    "./protocol": {
      "types": "./src/protocol.ts",
      "default": "./src/protocol.ts"
    },
    "./identity": {
      "types": "./src/identity.d.mts",
      "default": "./src/identity.mjs"
    },
    "./identity.json": "./src/identity.json",
    "./package.json": "./package.json"
  },
  "files": [
    "src/cli.mjs",
    "src/identity.mjs",
    "src/identity.d.mts",
    "src/identity.json",
    "dist",
    "skill"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/cli.mjs",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --test-timeout=45000 test/*.test.mjs",
    "prepack": "pnpm run build && node scripts/pack-skill.mjs"
  },
  "dependencies": {
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "typescript": "^5.7.2"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./protocol": {
        "types": "./dist/protocol.d.ts",
        "default": "./dist/protocol.js"
      },
      "./identity": {
        "types": "./src/identity.d.mts",
        "default": "./src/identity.mjs"
      },
      "./identity.json": "./src/identity.json",
      "./package.json": "./package.json"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novincode/solomotion.git",
    "directory": "packages/mcp"
  },
  "homepage": "https://github.com/novincode/solomotion/tree/main/packages/mcp#readme",
  "bugs": {
    "url": "https://github.com/novincode/solomotion/issues"
  }
}
