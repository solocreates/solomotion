{
  "name": "@solomotion/theme",
  "version": "1.0.0-beta.1",
  "description": "The theme file: one schema that picks colours, type, shape and a dialect for every part, compiled to CSS.",
  "private": true,
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./parts.css": "./parts.css",
    "./react": "./src/react/dial.tsx"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^2.1.9",
    "@types/react": "^19.2.18"
  },
  "peerDependencies": {
    "react": ">=19"
  },
  "license": "AGPL-3.0-only"
}
