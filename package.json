{
  "name": "solomotion-workspace",
  "version": "1.0.0-beta.2",
  "private": true,
  "license": "AGPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/solocreates/solomotion.git"
  },
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter ./apps/web dev",
    "build": "pnpm -r --filter=!./apps/desktop --if-present run build",
    "build:desktop": "pnpm --filter ./apps/web run build:static && pnpm --filter ./apps/desktop run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0"
    }
  }
}
