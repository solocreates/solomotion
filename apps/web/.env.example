# ─────────────────────────────────────────────────────────────────────────────
# The editor (@solomotion/web) — PUBLIC build-time config
#
# Everything here is NEXT_PUBLIC_* and ships to the browser. No secrets.
# Every value has a default in the product (products/<id>/web/identity.ts),
# so these are only needed to override one per environment.
# ─────────────────────────────────────────────────────────────────────────────

# Which product to build, when products/ holds more than one.
# PRODUCT=

# The product's website (docs, changelog, terms).
# NEXT_PUBLIC_SITE_URL=

# ── Content library ─────────────────────────────────────────────────────────
# Catalogue root. Static JSON + immutable blobs, no credentials.
# NEXT_PUBLIC_LIBRARY_BASE_URL=

# Lazy engines (models, runtimes). In development they are served from /models.
# NEXT_PUBLIC_MODELS_BASE=

# Icon search proxy (the public Iconify API is always the fallback).
# NEXT_PUBLIC_ICONS_API=
