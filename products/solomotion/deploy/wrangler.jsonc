/**
 * The SoloMotion editor Worker — its OWN deploy, wholly separate from the site.
 * Served at open.solomotion.app. Shipping the app no longer touches the site
 * (and vice-versa): each has its own Worker, its own cadence.
 *
 * The editor serves several products; this config is SoloMotion's, and only
 * `PRODUCT=solomotion` builds reach it (apps/web/scripts/deploy.mjs). Paths are
 * relative to this file.
 *
 * https://developers.cloudflare.com/workers/wrangler/configuration/
 */
{
	"$schema": "../../../apps/web/node_modules/wrangler/config-schema.json",
	"name": "solomotion-app",
	"main": "../../../apps/web/.open-next/worker.js",
	"compatibility_date": "2026-10-01",
	"compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
	"assets": {
		"binding": "ASSETS",
		"directory": "../../../apps/web/.open-next/assets"
	},
	// Bind the app to its subdomain. `custom_domain` provisions the DNS record +
	// route automatically as long as the `solomotion.app` zone is in the account.
	"routes": [{ "pattern": "open.solomotion.app", "custom_domain": true }],
	"images": {
		"binding": "IMAGES"
	},
	"services": [
		{
			// Self-reference binding for Next's cache — name MUST match `name` above.
			"binding": "WORKER_SELF_REFERENCE",
			"service": "solomotion-app"
		}
	],
	"observability": {
		"enabled": true
	}
}
